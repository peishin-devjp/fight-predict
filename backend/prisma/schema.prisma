// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FightStatus {
  scheduled
  finished
  draw
  no_contest
  cancelled
}

enum FightMethod {
  decision
  finish
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())
}

model Event {
  id         Int      @id @default(autoincrement())
  name       String
  date       DateTime
  deadline   DateTime
  createdAt  DateTime @default(now())
}

model Fight {
  id        Int      @id @default(autoincrement())
  eventId   Int
  fighter1Id Int
  fighter2Id Int?

  status     FightStatus @default(scheduled)
  winnerId   Int?
  method     FightMethod?

  fighter1   Fighter     @relation("FightFighter1", fields: [fighter1Id], references: [id])
  fighter2   Fighter?    @relation("FightFighter2", fields: [fighter2Id], references: [id])
  winner     Fighter?    @relation("FightWinner", fields: [winnerId], references: [id])

  createdAt DateTime @default(now())
}

model Fighter {
  id         Int      @id @default(autoincrement())
  name       String
  createdAt  DateTime @default(now())

  fightsAsFighter1 Fight[] @relation("FightFighter1")
  fightsAsFighter2 Fight[] @relation("FightFighter2")
  wonFights        Fight[] @relation("FightWinner")
}

model Prediction {
  id                Int      @id @default(autoincrement())
  userId            Int
  fightId           Int
  predictedWinnerId Int
  point           Int
  createdAt       DateTime @default(now())

  @@unique([userId, fightId])
}